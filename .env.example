# Smart Placement Readiness Analyser — Environment Configuration Example
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PLACEMENT_DB_PATH=backend/data/placement_readiness.db
SECRET_KEY=replace-with-strong-random-secret-in-production
TOKEN_EXPIRE_HOURS=24
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional AI Enrichment (Disabled by default; rule-based engine is primary)
AI_PROVIDER_ENABLED=false
AI_API_KEY=
AI_TIMEOUT_SECONDS=5.0
